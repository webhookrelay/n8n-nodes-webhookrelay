{
  "name": "Webhook Relay — inbound email to workflow",
  "nodes": [
    {
      "parameters": {
        "bucket": "n8n-email",
        "allowedSenders": "alerts@example.com",
        "dropAttachments": false,
        "durableDelivery": true,
        "durabilitySchedule": "medium",
        "throttleEnabled": false
      },
      "id": "e1e1e1e1-1111-4111-8111-111111111111",
      "name": "Webhook Relay Email Trigger",
      "type": "n8n-nodes-webhookrelay.webhookRelayEmailTrigger",
      "typeVersion": 1,
      "position": [640, 300],
      "credentials": {
        "webhookRelayApi": {
          "id": "1",
          "name": "Webhook Relay account"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "from",
              "value": "={{ $json.body.from }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "subject",
              "value": "={{ $json.body.subject }}",
              "type": "string"
            },
            {
              "id": "a3",
              "name": "text",
              "value": "={{ $json.body.text }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "f2f2f2f2-2222-4222-8222-222222222222",
      "name": "Extract email fields",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [900, 300]
    }
  ],
  "connections": {
    "Webhook Relay Email Trigger": {
      "main": [
        [
          {
            "node": "Extract email fields",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
